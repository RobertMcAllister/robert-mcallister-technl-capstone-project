{
  "LambdaFunctionConfigurations": [
    {
      "Id": "DispatcherTrigger",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:<AWS_ACCOUNT_ID>:function:Robert-McAllister-Dispatcher",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            {"Name": "prefix", "Value": "raw/"}
          ]
        }
      }
    }
  ]
}
